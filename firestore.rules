rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ADMIN_EMAIL_HERE'
        && request.auth.token.email_verified == true;
    }
    match /materials/{id} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    match /students/{id} { allow read, write: if isAdmin(); }
    match /lessons/{id} { allow read, write: if isAdmin(); }
    match /payments/{id} { allow read, write: if isAdmin(); }
    match /studentViews/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }
  }
}
